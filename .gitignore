# -----------------------------------------------------------------------------
# NeuroTrack AI .gitignore
# Project detected: MERN stack
# - Frontend: React + Vite + Tailwind CSS
# - Backend: Node.js + Express + MongoDB/Mongoose
# - Deployment: Render/Vercel-style config files
# No Next.js, Python, Java, or Firebase project files were detected.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Dependency folders
# Keep package.json and package-lock.json tracked, but never commit installed deps.
# -----------------------------------------------------------------------------
node_modules/
frontend/node_modules/
backend/node_modules/

# -----------------------------------------------------------------------------
# Environment variables and secrets
# Real env files can contain JWT secrets, MongoDB URIs, OpenAI keys, SMTP creds,
# and cookie/session settings. Keep example templates for collaborators.
# -----------------------------------------------------------------------------
.env
.env.*
frontend/.env
frontend/.env.*
backend/.env
backend/.env.*
!.env.example
!frontend/.env.example
!backend/.env.example

# -----------------------------------------------------------------------------
# Production builds and generated bundles
# Vite emits frontend/dist. Other common JS build outputs are included for safety.
# -----------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
.next/
frontend/dist/
frontend/dist-ssr/
frontend/build/
backend/dist/
backend/build/

# -----------------------------------------------------------------------------
# Caches and generated tool output
# These are regenerated locally by Vite, ESLint, Rollup, package managers, etc.
# -----------------------------------------------------------------------------
.cache/
.parcel-cache/
.vite/
.vite-inspect/
.eslintcache
.stylelintcache
.turbo/
.rollup.cache/
coverage/
frontend/coverage/
backend/coverage/

# -----------------------------------------------------------------------------
# Logs and runtime diagnostics
# Avoid committing noisy logs or crash reports from npm, Node, or local servers.
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
frontend.log
backend.log
*.out.log
*.err.log

# -----------------------------------------------------------------------------
# Local databases, MongoDB dumps, and large backup artifacts
# Keep production data and database exports out of GitHub.
# -----------------------------------------------------------------------------
dump/
dumps/
backup/
backups/
*.dump
*.bson
*.archive
*.sqlite
*.sqlite3
*.db

# -----------------------------------------------------------------------------
# Package manager and install caches
# Lockfiles are intentionally not ignored.
# -----------------------------------------------------------------------------
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# -----------------------------------------------------------------------------
# Editor, IDE, and local AI assistant metadata
# These are machine-specific. Remove an entry if your team intentionally shares it.
# -----------------------------------------------------------------------------
.vscode/
.idea/
.cursor/
.sixth/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# -----------------------------------------------------------------------------
# Operating system generated files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Temporary files
# -----------------------------------------------------------------------------
tmp/
temp/
.git-repair-backups/
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej

# -----------------------------------------------------------------------------
# Test and browser automation artifacts
# Useful for local debugging, not for source control.
# -----------------------------------------------------------------------------
playwright-report/
test-results/
cypress/videos/
cypress/screenshots/
lighthouse-report/
*.har

# -----------------------------------------------------------------------------
# Deployment/local hosting artifacts
# Keep deployment config like render.yaml, vercel.json, and package files tracked.
# -----------------------------------------------------------------------------
.vercel/
.netlify/
